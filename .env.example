# Pics.io account used by the tests (email + password login, not Google SSO)
PICSIO_EMAIL=you@example.com
PICSIO_PASS=your-password
# API key from Pics.io: My account -> API key. Used for setup/cleanup over the REST API.
PICSIO_API_KEY=eyJ...
# Optional: a second account invited to the same team (any role). Enables the "team vs personal for a teammate" test.
PICSIO_TEAMMATE_EMAIL=
PICSIO_TEAMMATE_PASS=
